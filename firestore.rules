rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validAnnouncement(data) {
      return data.keys().hasOnly([
          'userId', 'type', 'status', 'createdAt', 'reunitedAt', 'name',
          'species', 'breed', 'color', 'size', 'characteristics',
          'lastSeenAt', 'neighborhood', 'referencePoint', 'photoUrl',
          'contactWhatsapp'
        ])
        && data.keys().hasAll(['userId', 'type', 'status', 'createdAt'])
        && data.type in ['lost', 'found']
        && data.status in ['active', 'reunited'];
    }

    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && validAnnouncement(request.resource.data);
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && validAnnouncement(request.resource.data);
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
